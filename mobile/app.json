{
  "expo": {
    "name": "LinkdUp",
    "slug": "linkdup",
    "scheme": "linkdup",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0B14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.linkdup.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LinkdUp needs your location to find a fair meetup spot for your crew."
      }
    },
    "android": {
      "package": "com.linkdup.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "LinkdUp",
      "shortName": "LinkdUp",
      "description": "Find the perfect hangout spot for your crew. Swipe together, meet in the middle.",
      "lang": "en",
      "themeColor": "#6C3EF4",
      "backgroundColor": "#0A0A0F",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LinkdUp to use your location."
        }
      ]
    ]
  }
}
