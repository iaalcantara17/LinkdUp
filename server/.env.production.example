NODE_ENV=production

# Supabase — copy from Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud — Maps + Places + Geocoding key (same key works for all three)
GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 — for Google Calendar integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.linkdup.app/api/calendar/oauth/callback

# CORS — set to your Vercel / custom frontend domain
CORS_ORIGIN=https://linkdup.app

# Gemini AI — optional; falls back to static pitch text if absent
# Must be from AI Studio (aistudio.google.com), NOT a billing-enabled Google Cloud project
GEMINI_API_KEY=

# PORT is injected automatically by Railway — do NOT set it here
