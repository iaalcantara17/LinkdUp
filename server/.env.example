PORT=3000
NODE_ENV=development

# Supabase — copy from Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud — Maps, Places, Geocoding (one key covers all three)
GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 — for Google Calendar integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

# CORS
CORS_ORIGIN=*

# Gemini AI (optional — falls back to static pitch text if absent)
# Create at https://aistudio.google.com/app/apikey in a project with NO billing attached
GEMINI_API_KEY=
